DATABASE_URL="file:./dev.db"

# nuxt-auth-utils session encryption key (>= 32 chars)
# generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=""

# Google OAuth — fill in from Google Cloud Console
# Authorized redirect URI: http://localhost:3000/api/auth/google
NUXT_OAUTH_GOOGLE_CLIENT_ID=""
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=""

# App URL used for outbound email links
APP_URL="http://localhost:3000"

# SMTP — leave SMTP_HOST blank in dev to log emails to the console instead
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="elms <no-reply@example.com>"
