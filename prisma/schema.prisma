// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MaterialType {
  LINK
  PDF
  SLIDE
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  passwordHash    String?
  googleId        String?   @unique
  avatarUrl       String?
  role            Role      @default(STUDENT)
  timeZone        String?
  phone           String?
  country           String?
  age             Int?
  isActive              Boolean   @default(true)
  isAvailableForBooking Boolean   @default(true)
  emailVerified         Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tokens              VerificationToken[]
  coursesTaught       Course[]
  enrollments         Enrollment[]
  posts               BlogPost[]
  teacherAvailability TeacherAvailability[]
}

model VerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String // "email_verify" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

model Course {
  id            Int              @id @default(autoincrement())
  name          String
  description   String?
  imageUrl      String?
  price         Decimal          @default(0)
  totalSessions Int              @default(4)
  lsVariantId   String?
  isActive      Boolean          @default(true)
  teacherId     Int?
  teacher       User?            @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  materials     CourseMaterial[]
  enrollments   Enrollment[]
  promoCodes    PromoCode[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model CourseMaterial {
  id           Int          @id @default(autoincrement())
  courseId     Int
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  type         MaterialType
  url          String?
  filePath     String?
  isPrivate    Boolean      @default(false)
  enrollmentId Int?
  createdAt    DateTime     @default(now())
}

model TeacherAvailability {
  id        Int      @id @default(autoincrement())
  teacherId Int
  teacher   User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD
  startTime Int      // minutes from midnight
  endTime   Int      // minutes from midnight
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId, date])
}

model Enrollment {
  id            Int              @id @default(autoincrement())
  userId        Int
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId      Int
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status        EnrollmentStatus @default(PENDING)
  sessions      Session[]
  enrolledAt    DateTime         @default(now())
  lsOrderId     String?          @unique
  lsCustomerId  String?
  amountCents   Int?
  currency      String?
  paidAt        DateTime?
  paymentStatus String?
  promoCodeId   Int?
  promoCode     PromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([userId, courseId])
}

model Session {
  id              Int           @id @default(autoincrement())
  enrollmentId    Int
  enrollment      Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime
  durationMinutes Int           @default(60)
  zoomLink        String?
  status          SessionStatus @default(SCHEDULED)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model PromoCode {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  description     String?
  discountPercent Int
  maxUses         Int?
  usedCount       Int      @default(0)
  expiresAt       DateTime?
  isActive        Boolean  @default(true)
  courseId        Int?
  course          Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lsDiscountId    String?  @unique
  enrollments     Enrollment[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BlogCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  slug        String     @unique
  description String?
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model BlogTag {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  slug      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlogPost {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique
  description String?
  content     String?
  excerpt     String?
  imageUrl    String?
  published   Boolean       @default(false)
  publishedAt DateTime?
  authorId    Int
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId  Int?
  category    BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        BlogPostTag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model BlogPostTag {
  postId Int
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  Int
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}
